{
  "name": "nextjs-application-template-1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev-https": "next dev --experimental-https",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests --dir prisma --file middleware.ts --file playwright.config.ts --file vitest.config.mts --file vitest.integration.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "playwright-development": "npx playwright test"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@ngneat/falso": "^7.2.0",
    "@prisma/client": "^6.19.0",
    "@types/react-router-dom": "^5.3.3",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.3",
    "multiselect-react-dropdown": "^2.0.25",
    "next": "^14.2.24",
    "next-auth": "^4.24.13",
    "react": "^18",
    "react-bootstrap": "^2.10.4",
    "react-bootstrap-icons": "^1.11.4",
    "react-dom": "^18",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.6",
    "sweetalert": "^2.1.2",
    "ts-node": "10.9.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "^15.5.6",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.1",
    "prettier-eslint": "^16.3.0",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  }
